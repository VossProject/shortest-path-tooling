#!/bin/sh
# pre-push gate — the cheap tiers of `maintenance.py verify`.
#
# Catches the class of failures CI would flag before they leave the
# machine: Python tests (~2s) and the compile gate (~seconds warm).
# The dashboard sweep and collision diff stay in CI — they take
# minutes, not seconds.
#
# Install:
#   ln -sf ../../hooks/pre-push .git/hooks/pre-push
#
# Escape hatches (use sparingly — red CI costs a review round):
#   SKIP_TESTS=1    skip pytest
#   SKIP_COMPILE=1  skip compileTestJava
#   git push --no-verify  skip everything

set -e
cd "$(git rev-parse --show-toplevel)"

# Git exports GIT_DIR (and friends) while hooks run. validate_data.py
# shells out to `git -C shortest-path ls-files`, and an inherited
# GIT_DIR overrides that -C path, silently reading the parent index
# instead of the submodule's and emptying the corpus under test.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_QUARANTINE_PATH GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

if [ -z "$SKIP_TESTS" ]; then
    echo "pre-push: python3 -m pytest tests/ -x -q"
    python3 -m pytest tests/ -x -q
fi

if [ -z "$SKIP_COMPILE" ]; then
    echo "pre-push: ./gradlew compileTestJava"
    ./gradlew compileTestJava -q
fi
